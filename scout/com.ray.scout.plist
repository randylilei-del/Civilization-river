<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ray.scout</string>
    <key>ProgramArguments</key>
    <array>
        <string>/PATH/TO/scout/venv/bin/python3</string>
        <string>/PATH/TO/scout/scout.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/PATH/TO/scout</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/scout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/scout.err.log</string>
</dict>
</plist>
